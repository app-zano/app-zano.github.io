      "settings": {
        "main": true,
        "title": "Zano™ | Zeno Wallet | Buy, Sell, Trade, Use.",
        "meta_descr": "What is Zano (ZANO)?. Zano is a privacy-focused blockchain platform designed to provide secure, untraceable transactions and decentralized applications (dApps).",
        "header_custom": "",
        "footer_custom": "",
        "html_before": ""
